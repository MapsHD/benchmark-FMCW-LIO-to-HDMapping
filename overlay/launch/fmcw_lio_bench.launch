<?xml version="1.0"?>
<!-- Benchmark launch for FMCW-LIO: the upstream launch files (e.g.
     livox_mid360.launch) with the parameter file as a roslaunch arg, so one
     launch serves every sensor configuration.

     The ROS clock is left as is (no use_sim_time): FMCW-LIO stamps every
     output with the scan end time taken from the input messages, i.e. bag
     time, and publishes them in the "world" frame, which is the fixed frame
     of its RViz configs. -->
<launch>

    <arg name="config"      default="$(find fmcw_lio)/config/livox_mid360.yaml" />
    <arg name="rviz"        default="true" />
    <arg name="rviz_config" default="$(find fmcw_lio)/rviz/fmcw_lio_3d.rviz" />

    <rosparam command="load" file="$(arg config)" />

    <node pkg="fmcw_lio" type="fmcw_lio" name="fmcw_lio_node" output="screen" />

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="fmcw_lio_rviz" args="-d $(arg rviz_config)" />
    </group>

</launch>
